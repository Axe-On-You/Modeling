* UIR 3 Part 1: control_h2_050, replication 1
* Time unit is one second.
       RMULT 1621021382,1236364591,1927327154,2071818196,1406563226,1060564596,343409217
Cap1 STORAGE 257
Srv1 STORAGE 1
WTall TABLE P3,0,1.4395833333,65
STall TABLE M1,0,1.4395833333,65

       GENERATE (Exponential(2,0,11.516666667))
Route  MARK
In1    TEST L S$Cap1,257,Lost1
       ENTER Cap1
       QUEUE Queue1
       ENTER Srv1
       DEPART Queue1
       ASSIGN 3,M1
       TEST L (Uniform(4,0,1)),0.88729833462,Svc1Second
       ADVANCE (Exponential(3,0,3.2448687824))
       TRANSFER ,Svc1Join
Svc1Second ADVANCE (Exponential(3,0,25.546797884))
Svc1Join    TABULATE WTall
       TABULATE STall
       LEAVE Srv1
       LEAVE Cap1
Done1  TERMINATE 1
Lost1  TERMINATE 1

       START 10000,NP
       RESET
       START 120000
